#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=../mock_common.sh
. "${ZRO_MOCK_LIB:?ZRO_MOCK_LIB is required}/mock_common.sh"
zro_mock_record tail "$@"

# Records its argv and then does the real thing, unlike the Zimbra mocks which
# answer from a fixture. What has to be proved here is that the BOUND WAS
# APPLIED, and a fixture would prove only that a canned file was printed: the
# vector could carry any line count at all and the case would still pass.
#
# The real binary is reached through $PATH, which never contains this directory —
# the gate resolves every mock by absolute path out of its declared root.
#
# A failing read is scripted rather than produced with a mode, because the suite
# is run as root often enough that chmod 000 proves nothing there.
if [ -n "${ZRO_MOCK_TAIL_ERR:-}" ]; then
  printf '%s\n' "$ZRO_MOCK_TAIL_ERR" >&2
  exit "${ZRO_MOCK_TAIL_RC:-1}"
fi
exec tail "$@"
