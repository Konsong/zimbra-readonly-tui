#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=../mock_common.sh
. "${ZRO_MOCK_LIB:?ZRO_MOCK_LIB is required}/mock_common.sh"
zro_mock_record head "$@"

# Records its argv and then does the real thing, for the reason the tail and gzip
# mocks give: what the cases turn on is that the BOUND WAS APPLIED and that a real
# blob is really readable through this form. A mock printing a fixture would pass
# whether or not the vector carried any bound at all.
#
# The real binary is reached through $PATH, which never contains this directory — the
# gate resolves every mock by absolute path out of its declared root.
#
# A failing read is scripted rather than produced with a mode, because the suite is
# run as root often enough that chmod 000 proves nothing there.
if [ -n "${ZRO_MOCK_HEAD_ERR:-}" ]; then
  printf '%s\n' "$ZRO_MOCK_HEAD_ERR" >&2
  exit "${ZRO_MOCK_HEAD_RC:-1}"
fi
exec head "$@"
