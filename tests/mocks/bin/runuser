#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=../mock_common.sh
. "${ZRO_MOCK_LIB:?ZRO_MOCK_LIB is required}/mock_common.sh"
zro_mock_record runuser "$@"

# Strip runuser's own options, then run what follows so the chain continues on
# to the next mock exactly as it would on a real host.
while [ $# -gt 0 ]; do
  case $1 in
    -u) shift 2 ;;
    --) shift; break ;;
    *)  break ;;
  esac
done
[ $# -gt 0 ] || exit 0
exec "$@"
