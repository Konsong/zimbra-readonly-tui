#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=../mock_common.sh
. "${ZRO_MOCK_LIB:?ZRO_MOCK_LIB is required}/mock_common.sh"
zro_mock_record timeout "$@"

# Strip timeout's flags, then the duration, then run the rest.
while [ $# -gt 0 ]; do
  case $1 in
    -k) shift 2 ;;
    -*) shift ;;
    *)  break ;;
  esac
done
[ $# -gt 0 ] && shift

# Simulate expiry with the same status GNU timeout uses.
[ -n "${ZRO_MOCK_TIMEOUT_FIRE:-}" ] && exit 124

[ $# -gt 0 ] || exit 0
exec "$@"
