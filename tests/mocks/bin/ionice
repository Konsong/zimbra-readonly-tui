#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=../mock_common.sh
. "${ZRO_MOCK_LIB:?ZRO_MOCK_LIB is required}/mock_common.sh"
zro_mock_record ionice "$@"

# Records its argv and then runs what it was given, for the reason the nice mock
# beside it gives. The class is stripped rather than applied: a container without
# the block-layer scheduler would refuse the real call, and what the suite is
# holding the gate to is that it asked.
while [ $# -gt 0 ]; do
  case $1 in
    -c|-n|-p) shift 2 ;;
    -*) shift ;;
    *)  break ;;
  esac
done
[ $# -gt 0 ] || exit 0
exec "$@"
