#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=../mock_common.sh
. "${ZRO_MOCK_LIB:?ZRO_MOCK_LIB is required}/mock_common.sh"
zro_mock_record zmmailbox "$@"
# THE SUBCOMMAND IS FOURTH, and the reply is keyed on it rather than on the two
# tokens standing in front of it. This binary's vector is
# `-z -m <account> <subcommand>`: keyed the way every other mock is, every
# subcommand behind it would read one variable and answer the same text — a
# folder listing scripted by the fixture for a mailbox size. The exec gate puts
# that fixed prefix back on after the allowlist has read the subcommand in a
# position it can see; this reads it in the position the binary really gets it.
zro_mock_respond zmmailbox "$(zro_mock_token "${@:4}")"
