#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=../mock_common.sh
. "${ZRO_MOCK_LIB:?ZRO_MOCK_LIB is required}/mock_common.sh"
zro_mock_record id "$@"

# Two questions, two answers: who is running this, and which groups an account
# belongs to. Both are recorded, so a test can assert WHICH account was asked
# about — the log readability probe has to ask about the account every command
# runs as, never about whoever started the tool.
case ${1-} in
  -Gn) printf '%s\n' "${ZRO_MOCK_ID_GROUPS:-zimbra}" ;;
  *)   printf '%s\n' "${ZRO_MOCK_ID_USER:-nobody}" ;;
esac
