#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=../mock_common.sh
. "${ZRO_MOCK_LIB:?ZRO_MOCK_LIB is required}/mock_common.sh"
zro_mock_record zmmsgtrace "$@"

# One named file can be made unreadable, so that a scan over several files can be
# tested with a single one of them failing. That is the shape both this
# milestone's refusal and the next ticket's partial scan turn on, and keying the
# reply on the filter alone cannot express it.
#
# The message is the one documented in
# docs/research/2026-07-29-zimbra-cli-read-only-reference.md §B.11: the real tool
# dies with no exit status of its own, so the text is the only signal there is.
# Status 13 is what Perl hands back from that errno, matching the fixture the
# single-file cases use.
if [ -n "${ZRO_MOCK_ZMMSGTRACE_UNREADABLE:-}" ]; then
  for arg in "$@"; do
    if [ "$arg" = "$ZRO_MOCK_ZMMSGTRACE_UNREADABLE" ]; then
      printf "zmmsgtrace: unable to open file '%s': Permission denied\n" "$arg" >&2
      exit 13
    fi
  done
fi

# Keyed on the filter flag alone, unlike the Zimbra mocks. What follows a filter
# here is the operator's address, not a subcommand, so keying on it would make
# every test invent an environment variable name out of an e-mail address.
zro_mock_respond zmmsgtrace "${1:-}"
